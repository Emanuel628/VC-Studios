# Required in production: the backend's public URL. frontend-server.js proxies /api/*
# requests to this target, so the browser only ever talks to this frontend's own origin -
# see docs/backend-production-deployment.md for why that matters on Railway.
API_PROXY_TARGET=

# Only needed if the frontend is deployed somewhere that talks to the backend directly
# instead of through frontend-server.js's proxy (e.g. Vercel with a rewrite, or no proxy at
# all). Leave unset for local development and for the Railway proxy setup - vite.config.ts
# proxies /api to the local backend in dev, and frontend-server.js proxies it in production.
VITE_API_URL=
