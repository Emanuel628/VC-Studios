{
  "name": "platinum-vc-studios",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -n frontend,backend -c blue,green \"npm run dev\" \"npm --prefix server run dev\"",
    "dev:e2e-server": "concurrently -k -s first -n frontend,backend -c blue,green \"npm run dev\" \"npm --prefix server run dev:test-db\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "serve --single --listen $PORT dist",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:e2e"
  },
  "dependencies": {
    "better-auth": "^1.6.25",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "^8.3.0",
    "serve": "14.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.0.4",
    "concurrently": "^10.0.4",
    "jsdom": "^29.1.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "^4.1.10"
  }
}
